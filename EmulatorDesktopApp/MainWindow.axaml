<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:EmulatorDesktopApp.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1050" d:DesignHeight="750"
        x:Class="EmulatorDesktopApp.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Android Emulator Control Panel"
        Icon="/Assets/generated/app-icon.png"
        Width="1100" Height="800"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Border Padding="24">
        <Grid RowDefinitions="Auto,Auto,*,Auto">

            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Android Emulator Control Panel"
                          FontSize="28"
                          FontWeight="Bold"
                          Foreground="#FFFFFF" />
                <TextBlock Text="Connect, create a session, then start stream (Android emulator mirror)"
                          FontSize="14"
                          Foreground="#888888"
                          Margin="0,4,0,0" />
            </StackPanel>

            <Border Grid.Row="1"
                    Background="#2D2D2D"
                    CornerRadius="12"
                    Padding="20"
                    Margin="0,0,0,16">
                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4"
                              Text="WebSocket Server URL"
                              FontSize="12"
                              FontWeight="SemiBold"
                              Foreground="#AAAAAA"
                              Margin="0,0,0,8" />
                    <TextBox Grid.Row="1" Grid.Column="0"
                            Text="{Binding WebSocketUrl}"
                            PlaceholderText="ws://localhost:8080"
                            FontSize="14"
                            Padding="12,10"
                            CornerRadius="8"
                            Background="#3C3C3C"
                            BorderBrush="#555555"
                            Foreground="#FFFFFF"
                            Margin="0,0,12,0" />
                    <Button Grid.Row="1" Grid.Column="1"
                           Content="Connect"
                           Command="{Binding ConnectCommand}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Padding="20,10"
                           CornerRadius="8"
                           Background="#0078D4"
                           Foreground="#FFFFFF"
                           Margin="0,0,8,0"
                           Cursor="Hand" />
                    <Button Grid.Row="1" Grid.Column="2"
                           Content="Disconnect"
                           Command="{Binding DisconnectCommand}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Padding="20,10"
                           CornerRadius="8"
                           Background="#6C757D"
                           Foreground="#FFFFFF"
                           Margin="0,0,8,0"
                           Cursor="Hand" />
                    <Border Grid.Row="1" Grid.Column="3"
                           CornerRadius="8"
                           Padding="12,10"
                           Background="#3C3C3C"
                           VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="10" Height="10" VerticalAlignment="Center">
                                <Ellipse.Fill>
                                    <SolidColorBrush Color="{Binding ConnectionStatusColor}" />
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock Text="{Binding ConnectionStatusText}"
                                      FontSize="13"
                                      FontWeight="SemiBold"
                                      Foreground="#FFFFFF"
                                      VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Background="#2D2D2D"
                    CornerRadius="12"
                    Margin="0,0,0,16">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0"
                           Background="#363636"
                           CornerRadius="12,12,0,0"
                           Padding="16,12">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0"
                                      Text="Logs"
                                      FontSize="16"
                                      FontWeight="SemiBold"
                                      Foreground="#FFFFFF" />
                            <Button Grid.Column="1"
                                   Content="Clear"
                                   Command="{Binding ClearLogsCommand}"
                                   FontSize="12"
                                   Padding="12,6"
                                   CornerRadius="6"
                                   Background="#4A4A4A"
                                   Foreground="#CCCCCC"
                                   Cursor="Hand" />
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1"
                                 HorizontalScrollBarVisibility="Auto"
                                 VerticalScrollBarVisibility="Auto"
                                 Name="LogsScrollViewer">
                        <SelectableTextBlock Text="{Binding Logs}"
                                            FontFamily="Consolas, Monaco, 'Courier New', monospace"
                                            FontSize="13"
                                            Foreground="#E0E0E0"
                                            TextWrapping="Wrap"
                                            Margin="16"
                                            Name="LogsTextBlock" />
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Row="3"
                    Background="#2D2D2D"
                    CornerRadius="12"
                    Padding="20">
                <Grid RowDefinitions="Auto,Auto,12,Auto" ColumnDefinitions="*,Auto,Auto,Auto,Auto">

                    <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4"
                              Text="Device"
                              FontSize="12"
                              FontWeight="SemiBold"
                              Foreground="#AAAAAA"
                              Margin="0,0,0,8" />

                    <ComboBox Grid.Row="1" Grid.Column="0"
                             ItemsSource="{Binding Devices}"
                             SelectedItem="{Binding SelectedDevice}"
                             PlaceholderText="Select a device..."
                             FontSize="14"
                             Padding="12,10"
                             CornerRadius="8"
                             Background="#3C3C3C"
                             Foreground="#FFFFFF"
                             HorizontalAlignment="Stretch"
                             Margin="0,0,12,0">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:DeviceOption">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                        <Ellipse.Fill>
                                            <SolidColorBrush Color="{Binding StatusColor}" />
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <Border CornerRadius="4"
                                            Padding="5,2"
                                            VerticalAlignment="Center">
                                        <Border.Background>
                                            <SolidColorBrush Color="{Binding PlatformColor}" Opacity="0.18" />
                                        </Border.Background>
                                        <TextBlock Text="{Binding PlatformLabel}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Foreground>
                                                <SolidColorBrush Color="{Binding PlatformColor}" />
                                            </TextBlock.Foreground>
                                        </TextBlock>
                                    </Border>
                                    <TextBlock Text="{Binding DisplayName}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Border Grid.Row="1" Grid.Column="1"
                           Background="#3C3C3C"
                           CornerRadius="8"
                           Padding="12,10"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0">
                        <TextBlock Text="{Binding SessionStatus}"
                                  FontSize="12"
                                  Foreground="#4CAF50"
                                  FontWeight="SemiBold"
                                  TextTrimming="CharacterEllipsis"
                                  ToolTip.Tip="{Binding SessionId}" />
                    </Border>

                    <Button Grid.Row="1" Grid.Column="2"
                           Content="Refresh"
                           Command="{Binding RefreshDevicesCommand}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Padding="16,10"
                           CornerRadius="8"
                           Background="#6C757D"
                           Foreground="#FFFFFF"
                           Margin="0,0,8,0"
                           Cursor="Hand" />

                    <Button Grid.Row="1" Grid.Column="3"
                           Content="Create Session"
                           Command="{Binding CreateSessionCommand}"
                           FontSize="13"
                           FontWeight="Bold"
                           Padding="16,10"
                           CornerRadius="8"
                           Background="#0078D4"
                           Foreground="#FFFFFF"
                           Margin="0,0,8,0"
                           Cursor="Hand" />

                    <Button Grid.Row="1" Grid.Column="4"
                           Content="Destroy Session"
                           Command="{Binding DestroySessionCommand}"
                           FontSize="13"
                           FontWeight="Bold"
                           Padding="16,10"
                           CornerRadius="8"
                           Background="#DC3545"
                           Foreground="#FFFFFF"
                           Margin="0,0,0,0"
                           Cursor="Hand" />

                    <TextBlock Grid.Row="3" Grid.Column="0"
                              Text="Stream"
                              FontSize="12"
                              FontWeight="SemiBold"
                              Foreground="#AAAAAA"
                              VerticalAlignment="Center" />

                    <Border Grid.Row="3" Grid.Column="1"
                           Background="#3C3C3C"
                           CornerRadius="8"
                           Padding="12,10"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="10" Height="10" VerticalAlignment="Center">
                                <Ellipse.Fill>
                                    <SolidColorBrush Color="{Binding StreamStatusColor}" />
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock Text="{Binding StreamStatus}"
                                      FontSize="12"
                                      FontWeight="SemiBold">
                                <TextBlock.Foreground>
                                    <SolidColorBrush Color="{Binding StreamStatusColor}" />
                                </TextBlock.Foreground>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Button Grid.Row="3" Grid.Column="2"
                           Content="Start Stream"
                           Command="{Binding StartStreamCommand}"
                           FontSize="13"
                           FontWeight="Bold"
                           Padding="16,10"
                           CornerRadius="8"
                           Background="#9C27B0"
                           Foreground="#FFFFFF"
                           Margin="0,0,8,0"
                           Cursor="Hand" />

                    <Button Grid.Row="3" Grid.Column="3"
                           Content="Stop Stream"
                           Command="{Binding StopStreamCommand}"
                           FontSize="13"
                           FontWeight="Bold"
                           Padding="16,10"
                           CornerRadius="8"
                           Background="#FF5722"
                           Foreground="#FFFFFF"
                           Cursor="Hand" />

                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
