<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EmulatorDesktopApp.ViewModels"
        x:Class="EmulatorDesktopApp.StreamWindow"
        x:DataType="vm:StreamWindowViewModel"
        Title="{Binding WindowTitle}"
        Icon="/Assets/generated/stream-icon.png"
        Width="417"
        Height="680"
        MinWidth="320"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="#1A1A1A"
        Focusable="True">

    <Window.Styles>
        <Style Selector="Button.emu-tool">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Foreground" Value="#5F6368" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.emu-tool:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#DADCE0" />
        </Style>
        <Style Selector="Button.emu-tool:disabled">
            <Setter Property="Opacity" Value="0.35" />
        </Style>
        <Style Selector="Viewbox.emu-icon">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
        </Style>
        <Style Selector="Path.emu-icon-fill">
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Fill" Value="#5F6368" />
        </Style>
        <Style Selector="Path.emu-icon-stroke">
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="Stroke" Value="#5F6368" />
            <Setter Property="StrokeThickness" Value="1.75" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
        </Style>
        <Style Selector="Border.emu-toolbar-separator">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="#DADCE0" />
            <Setter Property="Margin" Value="10,8" />
        </Style>

        <!-- ── iOS Simulator viewer chrome (iOS only) ─────────────────────── -->
        <Style Selector="Button.ios-chrome">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.ios-chrome:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#3A3A3C" />
        </Style>
        <Style Selector="Button.ios-chrome:disabled">
            <Setter Property="Opacity" Value="0.35" />
        </Style>
        <Style Selector="Path.ios-chrome-icon">
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="Stroke" Value="#C7C7CC" />
            <Setter Property="StrokeThickness" Value="1.6" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*">
        <!-- Top app bar (Android viewer only) -->
        <Border x:Name="AppBar"
                Grid.Row="0"
                Background="#1A1A1A"
                Padding="12,8"
                IsVisible="{Binding ShowAndroidViewer}">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0"
                            MinWidth="0"
                            Margin="0,0,8,0"
                            Spacing="4">
                    <TextBlock Text="{Binding DeviceLabel}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#FFFFFF"
                               TextTrimming="CharacterEllipsis" />
                    <Grid ColumnDefinitions="Auto,Auto,*"
                          MinWidth="0">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding StreamStatus}"
                                   FontSize="12"
                                   Foreground="#AAAAAA"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding SessionHint}"
                                   FontSize="11"
                                   Foreground="#777777"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding SessionHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding MetricsText}"
                                   FontSize="11"
                                   Foreground="#88FF88"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Stop"
                        Command="{Binding StopStreamCommand}"
                        VerticalAlignment="Top"
                        Margin="0,1,0,0"
                        Padding="10,4"
                        MinWidth="52"
                        FontSize="11"
                        CornerRadius="4"
                        Background="#FF5722"
                        Foreground="#FFFFFF"
                        FontWeight="SemiBold"
                        Cursor="Hand" />
            </Grid>
        </Border>

        <!-- Video + divider + side toolbar (Android viewer only) -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,1,Auto"
              IsVisible="{Binding ShowAndroidViewer}">
            <Border x:Name="VideoColumn"
                    Grid.Column="0"
                    Width="400"
                    Background="#000000"
                    ClipToBounds="True">
                <Grid>
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsVisible="{Binding ShowVideoPlaceholder}"
                                Spacing="12">
                        <ProgressBar IsIndeterminate="True"
                                     Width="120"
                                     Height="4"
                                     Foreground="#FF5722"
                                     Background="#333333" />
                    </StackPanel>
                    <Border x:Name="VideoSurface"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Background="Transparent"
                            Focusable="True"
                            IsVisible="{Binding HasVideoFrame}">
                        <Image x:Name="VideoImage"
                               Source="{Binding CurrentFrame}"
                               Stretch="Uniform"
                               RenderOptions.BitmapInterpolationMode="HighQuality"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Stretch" />
                    </Border>
                    <!-- Capture-stall overlay: shown when capture goes quiet for 500ms+ -->
                    <Border IsVisible="{Binding IsVideoStalled}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,24"
                            Background="#CC1A1A1A"
                            CornerRadius="14"
                            Padding="14,7">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Ellipse Width="7" Height="7"
                                     Fill="#FFAA00"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="Buffering..."
                                       Foreground="#FFFFFF"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Background="#000000"
                    IsVisible="{Binding ShowSideToolbar}" />

            <Border Grid.Column="2"
                    Width="56"
                    Background="#ECECEC"
                    BorderThickness="0"
                    IsVisible="{Binding ShowSideToolbar}">
                <StackPanel Margin="0,10,0,10" Spacing="0">

                    <Button Classes="emu-tool"
                            ToolTip.Tip="Power"
                            Command="{Binding PowerCommand}">
                        <Viewbox Classes="emu-icon">
                            <Canvas Width="24" Height="24">
                                <Path Stroke="#5F6368"
                                      StrokeThickness="2"
                                      StrokeLineCap="Round"
                                      Fill="Transparent"
                                      Data="M12,2.5 L12,9.5" />
                                <Path Stroke="#5F6368"
                                      StrokeThickness="2"
                                      StrokeLineCap="Round"
                                      Fill="Transparent"
                                      Data="M7,10 A5.5,5.5 0 1,1 17,10" />
                            </Canvas>
                        </Viewbox>
                    </Button>

                    <Button Classes="emu-tool"
                            ToolTip.Tip="Volume up"
                            Command="{Binding VolumeUpCommand}">
                        <Viewbox Classes="emu-icon">
                            <Path Classes="emu-icon-fill"
                                  Data="M3,10 L3,14 L7,14 L12,19 L12,5 L7,10 Z M16.5,12 C16.5,10.23 15.48,8.71 14,7.97 L14,16.03 C15.48,15.29 16.5,13.77 16.5,12 Z M18.5,12 C18.5,9.46 17.02,7.28 14.75,6.23 L14.75,17.77 C17.02,16.72 18.5,14.54 18.5,12 Z" />
                        </Viewbox>
                    </Button>

                    <Button Classes="emu-tool"
                            ToolTip.Tip="Volume down"
                            Command="{Binding VolumeDownCommand}">
                        <Viewbox Classes="emu-icon">
                            <Path Classes="emu-icon-fill"
                                  Data="M3,10 L3,14 L7,14 L12,19 L12,5 L7,10 Z" />
                        </Viewbox>
                    </Button>

                    <Button Classes="emu-tool"
                            ToolTip.Tip="Screenshot"
                            Command="{Binding ScreenshotCommand}">
                        <Viewbox Classes="emu-icon">
                            <Path Classes="emu-icon-fill"
                                  Data="M9,3 L7.17,5 L4,5 C2.9,5 2,5.9 2,7 L2,17 C2,18.1 2.9,19 4,19 L20,19 C21.1,19 22,18.1 22,17 L22,7 C22,5.9 21.1,5 20,5 L16.83,5 L15,3 Z M12,17 C9.24,17 7,14.76 7,12 C7,9.24 9.24,7 12,7 C14.76,7 17,9.24 17,12 C17,14.76 14.76,17 12,17 Z M12,9 C10.34,9 9,10.34 9,12 C9,13.66 10.34,15 12,15 C13.66,15 15,13.66 15,12 C15,10.34 13.66,9 12,9 Z" />
                        </Viewbox>
                    </Button>

                    <Border Classes="emu-toolbar-separator" />

                    <Button Classes="emu-tool"
                            ToolTip.Tip="Back"
                            Command="{Binding BackCommand}">
                        <Viewbox Classes="emu-icon">
                            <Path Classes="emu-icon-fill"
                                  Data="M15.41,7.41 L14,6 L6,12 L14,18 L15.41,16.59 L10.83,12 Z" />
                        </Viewbox>
                    </Button>

                    <Button Classes="emu-tool"
                            ToolTip.Tip="Home"
                            Command="{Binding HomeCommand}">
                        <Viewbox Classes="emu-icon">
                            <Ellipse Width="16"
                                     Height="16"
                                     Stroke="#5F6368"
                                     StrokeThickness="2"
                                     Fill="Transparent" />
                        </Viewbox>
                    </Button>

                    <Button Classes="emu-tool"
                            ToolTip.Tip="Overview"
                            Command="{Binding RecentAppsCommand}">
                        <Viewbox Classes="emu-icon">
                            <Rectangle Width="16"
                                       Height="16"
                                       Stroke="#5F6368"
                                       StrokeThickness="2"
                                       RadiusX="2"
                                       RadiusY="2"
                                       Fill="Transparent" />
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ── iOS Simulator viewer (iOS only) ─────────────────────────────── -->
        <!-- Pure presentation: the device frame + chrome are decorative. Touch is
             computed from IosVideoSurface bounds (the screen rect) with the same
             letterbox-aware geometry as Android, so the frame never affects the
             coordinates sent to the simulator. -->
        <Grid Grid.Row="1"
              RowDefinitions="Auto,*"
              Background="#111114"
              IsVisible="{Binding IsIosViewer}">

            <!-- Simulator-style chrome header -->
            <Border Grid.Row="0"
                    Background="#2C2C2E"
                    BorderBrush="#3A3A3C"
                    BorderThickness="0,0,0,1"
                    Height="46"
                    Padding="12,0">
                <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                    <!-- Stop stream -->
                    <Button Grid.Column="0"
                            Content="Stop"
                            Command="{Binding StopStreamCommand}"
                            VerticalAlignment="Center"
                            Padding="10,4"
                            MinWidth="52"
                            FontSize="11"
                            CornerRadius="4"
                            Background="#FF5722"
                            Foreground="#FFFFFF"
                            FontWeight="SemiBold"
                            Cursor="Hand" />

                    <!-- Device title -->
                    <StackPanel Grid.Column="1"
                                Margin="14,0"
                                Spacing="0"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <TextBlock Text="{Binding IosDeviceName}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#FFFFFF"
                                   HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding IosRuntimeLabel}"
                                   FontSize="10"
                                   Foreground="#9A9AA0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Chrome actions: Home / Screenshot / Fullscreen -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="2"
                                VerticalAlignment="Center">
                        <Button Classes="ios-chrome"
                                ToolTip.Tip="Home"
                                Command="{Binding HomeCommand}">
                            <Viewbox Width="17" Height="17">
                                <Canvas Width="24" Height="24">
                                    <Path Classes="ios-chrome-icon"
                                          Data="M12,3 L21,11 M3,11 L12,3 M5.5,9.5 L5.5,20 L18.5,20 L18.5,9.5" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button Classes="ios-chrome"
                                ToolTip.Tip="Screenshot"
                                Command="{Binding ScreenshotCommand}">
                            <Viewbox Width="17" Height="17">
                                <Canvas Width="24" Height="24">
                                    <Path Classes="ios-chrome-icon"
                                          Data="M4,8 L7,8 L9,5 L15,5 L17,8 L20,8 Q21,8 21,9 L21,18 Q21,19 20,19 L4,19 Q3,19 3,18 L3,9 Q3,8 4,8 Z" />
                                    <Ellipse Canvas.Left="9" Canvas.Top="10" Width="6" Height="6"
                                             Stroke="#C7C7CC" StrokeThickness="1.6" Fill="Transparent" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button Classes="ios-chrome"
                                ToolTip.Tip="Toggle fullscreen"
                                Command="{Binding FullscreenCommand}">
                            <Viewbox Width="17" Height="17">
                                <Canvas Width="24" Height="24">
                                    <Path Classes="ios-chrome-icon"
                                          Data="M4,9 L4,4 L9,4 M15,4 L20,4 L20,9 M20,15 L20,20 L15,20 M9,20 L4,20 L4,15" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Device area -->
            <Grid Grid.Row="1">
                <!-- Physical device frame (bezel) -->
                <Border x:Name="IosDeviceFrame"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="20"
                        Padding="13"
                        Background="#0A0A0C"
                        CornerRadius="52"
                        BorderBrush="#26262A"
                        BorderThickness="5">
                    <Grid>
                        <!-- Screen (touch target). CornerRadius + clip mask the
                             rectangular framebuffer to iPhone screen corners. -->
                        <Border x:Name="IosVideoSurface"
                                Background="#000000"
                                CornerRadius="40"
                                ClipToBounds="True"
                                Focusable="True">
                            <Grid>
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding ShowVideoPlaceholder}"
                                            Spacing="12">
                                    <ProgressBar IsIndeterminate="True"
                                                 Width="120"
                                                 Height="4"
                                                 Foreground="#FF5722"
                                                 Background="#333333" />
                                </StackPanel>
                                <Image x:Name="IosVideoImage"
                                       Source="{Binding CurrentFrame}"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapInterpolationMode="HighQuality"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch"
                                       IsVisible="{Binding HasVideoFrame}" />
                            </Grid>
                        </Border>

                        <!-- Capture-stall overlay -->
                        <Border IsVisible="{Binding IsVideoStalled}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,40"
                                Background="#CC1A1A1A"
                                CornerRadius="14"
                                Padding="14,7">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Ellipse Width="7" Height="7"
                                         Fill="#FFAA00"
                                         VerticalAlignment="Center" />
                                <TextBlock Text="Buffering..."
                                           Foreground="#FFFFFF"
                                           FontSize="12"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
