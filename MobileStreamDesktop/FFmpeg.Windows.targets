<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- FFmpeg.AutoGen 8.1.0 requires GyanD/codexffmpeg 8.1 full_build-shared DLLs. -->

  <PropertyGroup>
    <FFmpegDestDir>$(MSBuildProjectDirectory)\ffmpeg\win-x64\</FFmpegDestDir>
    <FFmpegOutDir>$(OutDir)ffmpeg\win-x64\</FFmpegOutDir>
    <FFmpegZipUrl Condition="'$(FFmpegZipUrl)' == ''">https://github.com/GyanD/codexffmpeg/releases/download/8.1/ffmpeg-8.1-full_build-shared.zip</FFmpegZipUrl>
    <FFmpegCacheDir>$(LocalAppData)\MobileStreamDesktop\ffmpeg-cache</FFmpegCacheDir>
    <FFmpegZipFileName>ffmpeg-8.1-full_build-shared.zip</FFmpegZipFileName>
    <FFmpegBundleStampFile>$(FFmpegDestDir).bundle-source</FFmpegBundleStampFile>
    <FFmpegBundleStamp>gyan-codexffmpeg-8.1-full-shared</FFmpegBundleStamp>
    <FFmpegAutoDownload Condition="'$(FFmpegAutoDownload)' == ''">true</FFmpegAutoDownload>
  </PropertyGroup>

  <Target Name="EnsureNativeFFmpeg"
          BeforeTargets="BeforeBuild;PrepareForBuild;PrepareForPublish"
          Condition="'$(FFmpegAutoDownload)' == 'true'">
    <MakeDir Directories="$(FFmpegDestDir);$(FFmpegCacheDir)" />

    <ReadLinesFromFile File="$(FFmpegBundleStampFile)" Condition="Exists('$(FFmpegBundleStampFile)')">
      <Output TaskParameter="Lines" ItemName="_ExistingFfmpegStamp" />
    </ReadLinesFromFile>

    <ItemGroup>
      <_Ffmpeg81Avutil Include="$(FFmpegDestDir)avutil-60.dll" />
      <_Ffmpeg81Avcodec Include="$(FFmpegDestDir)avcodec-62.dll" />
    </ItemGroup>

    <PropertyGroup>
      <_ExistingFfmpegStampValue Condition="'@(_ExistingFfmpegStamp)' != ''">@(_ExistingFfmpegStamp)</_ExistingFfmpegStampValue>
      <_FfmpegBundleValid Condition="'@(_Ffmpeg81Avutil)' != '' and '@(_Ffmpeg81Avcodec)' != '' and '$(_ExistingFfmpegStampValue)' == '$(FFmpegBundleStamp)'">true</_FfmpegBundleValid>
    </PropertyGroup>

    <Message Importance="high" Text="[FFmpeg] Bundle OK — skipping download." Condition="'$(_FfmpegBundleValid)' == 'true'" />
    <Message Importance="high" Text="[FFmpeg] Downloading Gyan codexffmpeg 8.1 ..." Condition="'$(_FfmpegBundleValid)' != 'true'" />

    <ItemGroup Condition="'$(_FfmpegBundleValid)' != 'true'">
      <_StaleFfmpegBundleDll Include="$(FFmpegDestDir)*.dll" />
    </ItemGroup>
    <Delete Files="@(_StaleFfmpegBundleDll)" Condition="'$(_FfmpegBundleValid)' != 'true' and '@(_StaleFfmpegBundleDll)' != ''" />

    <PropertyGroup Condition="'$(_FfmpegBundleValid)' != 'true'">
      <_FFmpegZipPath>$(FFmpegCacheDir)\$(FFmpegZipFileName)</_FFmpegZipPath>
      <_FFmpegExtractDir>$(FFmpegCacheDir)\extract</_FFmpegExtractDir>
    </PropertyGroup>

    <DownloadFile SourceUrl="$(FFmpegZipUrl)"
                  DestinationFolder="$(FFmpegCacheDir)"
                  DestinationFileName="$(FFmpegZipFileName)"
                  SkipUnchangedFiles="false"
                  Retries="3"
                  Condition="'$(_FfmpegBundleValid)' != 'true'" />

    <RemoveDir Directories="$(_FFmpegExtractDir)" Condition="'$(_FfmpegBundleValid)' != 'true' and Exists('$(_FFmpegExtractDir)')" />
    <MakeDir Directories="$(_FFmpegExtractDir)" Condition="'$(_FfmpegBundleValid)' != 'true'" />

    <Exec Command="tar -xf &quot;$(_FFmpegZipPath)&quot; -C &quot;$(_FFmpegExtractDir)&quot;"
          Condition="'$(_FfmpegBundleValid)' != 'true'" />

    <ItemGroup Condition="'$(_FfmpegBundleValid)' != 'true'">
      <_FFmpegBinDlls Include="$(_FFmpegExtractDir)\**\bin\*.dll" />
    </ItemGroup>

    <Copy SourceFiles="@(_FFmpegBinDlls)"
          DestinationFolder="$(FFmpegDestDir)"
          SkipUnchangedFiles="false"
          OverwriteReadOnlyFiles="true"
          Condition="'$(_FfmpegBundleValid)' != 'true' and '@(_FFmpegBinDlls)' != ''" />

    <WriteLinesToFile File="$(FFmpegBundleStampFile)"
                      Lines="$(FFmpegBundleStamp)"
                      Overwrite="true"
                      Condition="'$(_FfmpegBundleValid)' != 'true' and '@(_FFmpegBinDlls)' != ''" />

    <RemoveDir Directories="$(_FFmpegExtractDir)" Condition="'$(_FfmpegBundleValid)' != 'true' and Exists('$(_FFmpegExtractDir)')" />

    <Warning Condition="!Exists('$(FFmpegDestDir)avutil-60.dll')"
             Text="FFmpeg DLLs missing in $(FFmpegDestDir). Run with network access or set FFMPEG_LIB_PATH." />
  </Target>

  <!-- Copy via MSBuild Copy task only (no Content/CopyToOutputDirectory — avoids MSB3024 on subfolders). -->
  <Target Name="CopyFfmpegNativeToOutput"
          AfterTargets="EnsureNativeFFmpeg"
          BeforeTargets="CoreBuild;CopyFilesToOutputDirectory"
          Condition="Exists('$(FFmpegDestDir)avutil-60.dll')">
    <CallTarget Targets="_CopyFfmpegNativeToOutputImpl" />
  </Target>

  <Target Name="CopyFfmpegNativeAfterBuild"
          AfterTargets="Build"
          Condition="Exists('$(FFmpegDestDir)avutil-60.dll')">
    <CallTarget Targets="_CopyFfmpegNativeToOutputImpl" />
  </Target>

  <Target Name="CopyFfmpegNativeBeforePublish"
          AfterTargets="EnsureNativeFFmpeg"
          BeforeTargets="ComputeFilesToPublish"
          Condition="Exists('$(FFmpegDestDir)avutil-60.dll')">
    <PropertyGroup>
      <FFmpegOutDir>$(PublishDir)ffmpeg\win-x64\</FFmpegOutDir>
    </PropertyGroup>
    <CallTarget Targets="_CopyFfmpegNativeToOutputImpl" />
  </Target>

  <Target Name="_CopyFfmpegNativeToOutputImpl">
    <ItemGroup>
      <_FfmpegNativeDll Include="$(FFmpegDestDir)avutil-60.dll" />
      <_FfmpegNativeDll Include="$(FFmpegDestDir)swresample-6.dll" />
      <_FfmpegNativeDll Include="$(FFmpegDestDir)swscale-9.dll" />
      <_FfmpegNativeDll Include="$(FFmpegDestDir)avcodec-62.dll" />
      <_FfmpegNativeDll Include="$(FFmpegDestDir)avformat-62.dll" />
      <_FfmpegNativeDll Include="$(FFmpegDestDir)avfilter-11.dll" />
      <_FfmpegNativeDll Include="$(FFmpegDestDir)avdevice-62.dll" />
      <_StaleFfmpegOutRootDll Include="$(OutDir)avutil-*.dll" />
      <_StaleFfmpegOutRootDll Include="$(OutDir)avcodec-*.dll" />
      <_StaleFfmpegOutRootDll Include="$(OutDir)avformat-*.dll" />
      <_StaleFfmpegOutRootDll Include="$(OutDir)avfilter-*.dll" />
      <_StaleFfmpegOutRootDll Include="$(OutDir)avdevice-*.dll" />
      <_StaleFfmpegOutRootDll Include="$(OutDir)swresample-*.dll" />
      <_StaleFfmpegOutRootDll Include="$(OutDir)swscale-*.dll" />
      <_StaleFfmpegOutRootDll Include="$(OutDir)postproc-*.dll" />
    </ItemGroup>
    <Delete Files="@(_StaleFfmpegOutRootDll)" Condition="'@(_StaleFfmpegOutRootDll)' != ''" />
    <MakeDir Directories="$(OutDir);$(FFmpegOutDir)" />
    <Copy SourceFiles="@(_FfmpegNativeDll)"
          DestinationFolder="$(FFmpegOutDir)"
          SkipUnchangedFiles="false"
          OverwriteReadOnlyFiles="true" />
    <Message Importance="high" Text="[FFmpeg] Copied 7 DLL(s) to $(FFmpegOutDir)" />
  </Target>
</Project>
