# Stream v2 — continuous H.264 real-time mirror

# Capture resolution sent to `adb screenrecord --size=`.
# Larger = sharper but more encoder work + bandwidth.
STREAM_WIDTH=720
STREAM_HEIGHT=1280

# Pacer + RTP clock rate. 30 fps gives 33 ms tap-to-pixel slots vs the
# previous 50 ms at 20 fps — directly improves perceived input latency.
STREAM_FPS=30

# Receiver-side hint (FFmpeg bitrate). Not enforced — informational only.
STREAM_BITRATE=6M

# *** Encoder bitrate handed to `adb screenrecord --bit-rate=`. ***
# 6 Mbps at 720p / 30 fps eliminates the block corruption / "pixelation"
# that the previous 2 Mbps default produced. Raise to 8–10 Mbps for 1080p.
STREAM_RECORD_BITRATE=6000000

# Pacer queue size (frames). 60 ≈ 2 s buffer at 30 fps — large enough to
# absorb screenrecord burst writes, small enough that latency stays bounded.
STREAM_PACER_QUEUE_CAP=60

# Catch-up divisor: drain ceil(depth/N) frames per tick when behind.
# Lower = more aggressive catch-up = lower latency under bursts.
STREAM_PACER_CATCHUP_DIV=2

# Send fresh SPS+PPS every N ms so the decoder recovers from any UDP loss
# without a full reconnect. 0 = disabled.
STREAM_PARAM_REFRESH_MS=2000

# Capture: auto | agent | screenrecord
ADB_CAPTURE_MODE=auto

# Optional: restart screenrecord after N seconds (0 = until process ends)
# ADB_RECORD_MAX_SEC=180

# Agent
# AGENT_APK_PATH=/path/to/app-debug.apk
# ADB_CAPTURE_MODE=agent
